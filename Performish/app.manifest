<?xml version="1.0" encoding="utf-8"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <!-- Performish requests admin via this embedded manifest rather than a runtime relaunch-and-elevate dance -
       see DECISIONS.md ("Elevation"). Windows shows the UAC prompt before any app code runs, so there
       is no window where Performish is half-elevated. Almost every tweak here needs HKLM/service/Appx-
       deprovisioning access, so requiring it up front (rather than per-tweak) keeps behavior simple
       and auditable. -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and Windows 11 compatibility GUIDs - lets GetVersionEx-style APIs and shell
           behavior report correctly instead of falling back to a compatibility shim. -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}" />
    </application>
  </compatibility>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>
</assembly>
